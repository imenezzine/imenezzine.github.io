---
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { formatDate, getSorted, readingTime } from '../../lib/utils';

export async function getStaticPaths() {
  const articles = await getSorted('articles');
  return articles.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = [readingTime(entry.body)];
if (entry.data.updated) meta.push(`mis à jour le ${formatDate(entry.data.updated)}`);
---

<EntryLayout
  kind="Article"
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  kicker="✍️ Article"
  backHref="/articles"
  backLabel="Tous les articles"
  accent="pink"
  meta={meta}
  tags={entry.data.tags}
  canonical={entry.data.canonical}
>
  {
    (entry.data.canonical || entry.data.translation) && (
      <p slot="before" class="origin" data-pagefind-ignore>
        {entry.data.canonical && (
          <span>
            📰 Publié à l'origine sur <a href={entry.data.canonical}>{new URL(entry.data.canonical).hostname.replace('www.', '')}</a>
          </span>
        )}
        {entry.data.translation && (
          <a class="badge" href={entry.data.translation} hreflang={entry.data.lang === 'fr' ? 'en' : 'fr'}>
            {entry.data.lang === 'fr' ? '🇬🇧 Read in English' : '🇫🇷 Lire en français'}
          </a>
        )}
      </p>
    )
  }
  <Content />
</EntryLayout>

<style>
  .origin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.7rem 1rem;
    margin: 0 0 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-alt);
    font-size: 0.95rem;
  }
  .origin .badge {
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--tint);
    color: var(--accent);
  }
  .origin .badge:hover {
    background: var(--tint);
    color: var(--accent);
  }
</style>
