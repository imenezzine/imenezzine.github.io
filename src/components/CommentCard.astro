---
import type { CollectionEntry } from 'astro:content';
import { PODCAST } from '../site.config';
import { formatDate } from '../lib/utils';

interface Props {
  comment: CollectionEntry<'commentaires'>;
  /** Épisode commenté : affiche un lien vers lui (inutile sur la page de l'épisode). */
  episode?: CollectionEntry<'podcast'>;
}
const { comment, episode } = Astro.props;
const c = comment.data;
const month = formatDate(new Date(`${c.month}-01`), { month: 'long', year: 'numeric' });
---

<figure class="comment c-orange">
  <blockquote>
    <p>{c.text}</p>
  </blockquote>
  <figcaption>
    <span class="avatar" aria-hidden="true">{c.role ? '🎙️' : '🎧'}</span>
    <span class="who">
      <strong>{c.role ? `L'${c.role} de l'épisode` : 'Un·e auditeur·rice'}</strong>
      <span class="meta">
        {
          episode && (
            <>
              sur <a href={`/podcast/${episode.id}`}>{PODCAST.name} #{episode.data.number}</a> ·{' '}
            </>
          )
        }
        <a href={c.url} rel="noopener">{month} sur YouTube</a>
      </span>
    </span>
  </figcaption>
</figure>

<style>
  .comment {
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    break-inside: avoid;
  }
  blockquote {
    margin: 0;
    position: relative;
    padding-top: 1.4rem;
  }
  blockquote::before {
    content: '“';
    position: absolute;
    top: -0.9rem;
    left: -0.2rem;
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.45;
  }
  blockquote p {
    margin: 0;
    white-space: pre-line;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--accent);
    font-weight: 700;
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.1rem 0.5rem;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .meta {
    flex-basis: 100%;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .meta a {
    color: inherit;
  }
</style>
